                  <DataGridTextColumn Header="勝ち" Binding="{Binding Wins}" Width="100"/>
                  <DataGridTextColumn Header="負け" Binding="{Binding Losses}" Width="100"/>
                  <DataGridTextColumn Header="ゼロ" Binding="{Binding Zeros}" Width="100"/>
                  <DataGridTextColumn Header="勝率" Binding="{Binding WinRate}" Width="120"/>
                  <DataGridTextColumn Header="損益" Binding="{Binding Net}" Width="180"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
