                  <StackPanel Margin="4,3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="MaxPositionsValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center"/></Viewbox><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-10,0,0"><TextBlock FontSize="14.3" Text="最大同時保有ポジション" Foreground="{DynamicResource Muted}"/></Viewbox></StackPanel>
                  <StackPanel Margin="4,3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="LongPositionsValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center"/></Viewbox><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-10,0,0"><TextBlock FontSize="14.3" Text="ロング最大同時保有ポジション" Foreground="{DynamicResource Muted}"/></Viewbox></StackPanel>
                  <StackPanel Margin="4,3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="ShortPositionsValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center"/></Viewbox><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-10,0,0"><TextBlock FontSize="14.3" Text="ショート最大同時保有ポジション" Foreground="{DynamicResource Muted}"/></Viewbox></StackPanel>
                </UniformGrid>
                <UniformGrid x:Name="HoldingMetrics" Columns="3" Margin="20,0,20,18">
                  <StackPanel Margin="4,3" ToolTip="部分決済単位の保有時間の合計です。重複する保有期間も個別に加算します。"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="TotalHoldingValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="総保有時間" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
                  <StackPanel Margin="4,3" ToolTip="新規時刻から各決済時刻までの最長時間です。"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="MaxHoldingValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="最大保有時間" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
                  <StackPanel Visibility="Collapsed" Margin="4,3" ToolTip="新規時刻から各決済時刻までの最短時間です。"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="MinHoldingValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="最小保有時間" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
                  <StackPanel Margin="4,3" ToolTip="全決済の保有時間の算術平均です。"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="AverageHoldingValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="保有時間平均" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
                  <StackPanel Visibility="Collapsed" Margin="4,3" ToolTip="全決済を対象とする中央値です。"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="MedianHoldingValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextAlignment="Center" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="保有時間中央値" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
                </UniformGrid>
