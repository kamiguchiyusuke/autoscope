                  <StackPanel Margin="4,3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="MinPipsValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Gain}" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="最小獲得pips" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
