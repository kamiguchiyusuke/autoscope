<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ArmadaAnalyzer.Desktop" x:Class="ArmadaAnalyzer.Desktop.MainWindow" FontFamily="Yu Mincho,MS PMincho" Title="Auto Scope · 1.01" Icon="Assets/scope.ico" Width="1540" Height="1000" MinWidth="1180" MinHeight="780" Background="{DynamicResource Canvas}" AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver" Closing="Window_Closing">
  <Grid Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Padding="26,0">
      <Grid>
      <DockPanel x:Name="ActionsPanel" Margin="0,0,0,14">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ThemeButton" Content="ライト" Click="Theme_Click" ToolTip="ライト / ダーク切替 · Ctrl+Shift+T"/>
          <CheckBox x:Name="SoundToggle" Content="音" IsChecked="True" Click="Sound_Click" ToolTip="小さな操作音をオン / オフ" Margin="8,0,8,0"/>
          <CheckBox x:Name="MotionToggle" Content="動き" IsChecked="True" Click="Motion_Click" ToolTip="アニメーションを切替（Windowsの設定も尊重）" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <Image Source="Assets/scope-256.png" Width="30" Height="30" Margin="0,0,10,0" AutomationProperties.Name="Auto Scope ロゴ"/>
          <TextBlock Text="Auto Scope" FontFamily="Yu Mincho,MS PMincho" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Content="☰" Style="{StaticResource HeaderButton}" Click="Sidebar_Click"/>
        <Button Content="ロード" Style="{StaticResource HeaderButton}" Click="Workspace_Click" ToolTip="保存フォルダーを開く"/>
        <Button Content="CSV保存" Style="{StaticResource HeaderButton}" Click="Export_Click" ToolTip="分析対象の取引CSVを保存"/>
        <Button Content="データ取込" Style="{StaticResource HeaderButton}" Click="Import_Click"/>
        <Button Content="サンプル" Style="{StaticResource HeaderButton}" Click="Demo_Click"/>
        <Button x:Name="ReportButton" Content="レポート" Style="{StaticResource HeaderButton}" Click="Report_Click" ToolTip="現在の分析結果をPDFに保存"/>
        <TextBlock Text="分析   /   1.01" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="アプリ画面にファイルをドラッグ＆ドロップして、データを取り込めます"
                 FontSize="10" Foreground="{DynamicResource Muted}" Margin="240,0,0,3"
                 VerticalAlignment="Bottom" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="232"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="NavigationPanel" Margin="14,20,14,16">
            <TextBlock Text="波のゆくさきΣArmada" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="14,0,0,16"/>
            <RadioButton Tag="0" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="ホーム"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="conditions" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="計算条件"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="0" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked" IsChecked="True">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="計算結果"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="1" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="取引一覧"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="2" Visibility="Collapsed" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="時間帯一覧"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="3" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="ポートフォリオ"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="4" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="オートバックテスト"/>
              </StackPanel>
            </RadioButton>
            <RadioButton Tag="5" Visibility="Collapsed" GroupName="Navigation" Style="{StaticResource NavigationItem}" Checked="Navigation_Checked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="拡張機能"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
          <Grid Grid.Row="1" x:Name="DatasetPanel" Visibility="Collapsed" Margin="14,0,14,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <Separator/>
              <TextBlock Text="分析するデータ" FontSize="12" Foreground="{DynamicResource Muted}" Margin="4,12,0,8"/>
              <TextBlock x:Name="WorkspaceName" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/>
              <Button Content="全選択" Click="SelectAll_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,8"/>
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="DatasetList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Padding="0,12" Width="184">
                    <StackPanel>
                      <CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" ToolTip="{Binding Name}">
                        <CheckBox.Content>
                          <TextBlock Text="{Binding Name}" Width="160" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                        </CheckBox.Content>
                      </CheckBox>
                      <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="19,6,0,8"/>
                      <DockPanel Margin="19,0,0,0">
                        <TextBlock Text="ウェイト" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Weight,Mode=TwoWay}" Width="55" Padding="4,2" HorizontalAlignment="Right"/>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" Text="金額はレポートの数値をそのまま使用します。通貨の区別・換算は行いません。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="24,18,24,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="AnalysisToolbar" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14" Focusable="False">
          <Grid Width="{Binding ActualWidth,ElementName=AnalysisToolbar}" MinWidth="1000">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="ImportPanel" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="読込形式" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
          <ComboBox x:Name="ReaderBox" Width="186" SelectedIndex="0">
            <ComboBoxItem Content="MT4 / MT5 HTML"/>
          </ComboBox>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="ファイルをドロップして取込" ToolTip="ファイルをドロップして取込" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" x:Name="FiltersPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="決済期間" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
          <DatePicker x:Name="FromDate" Width="123"/>
          <TextBlock Text="〜" Margin="6,0" VerticalAlignment="Center"/>
          <DatePicker x:Name="ToDate" Width="123"/>
          <ComboBox x:Name="SideBox" Visibility="Collapsed" Width="100" Margin="12,0,0,0" SelectedIndex="0">
            <ComboBoxItem Content="すべて"/>
            <ComboBoxItem Content="ロング"/>
            <ComboBoxItem Content="ショート"/>
          </ComboBox>
          <TextBlock Text="初期資本" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="14,0,8,0"/>
          <TextBox x:Name="CapitalBox" Text="1000000" Width="96"/>
          <Button Content="分析する" Style="{StaticResource Primary}" Click="Analyze_Click" Margin="12,0,8,0"/>
          <Button Content="全期間" Click="ClearDates_Click"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <local:RetainedTabControl x:Name="Tabs" SelectedIndex="0" Grid.Row="1" Background="{DynamicResource Surface}" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
          <TabControl.Resources>
            <Style TargetType="TabItem">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            </Style>
          </TabControl.Resources>
          <TabItem Header="計算結果">
            <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Background="{DynamicResource Surface}" Margin="0,0,0,10">
                <Border x:Name="ResultTabsPanel" Background="{DynamicResource Raised}" Padding="4,0">
                  <StackPanel x:Name="PeriodTabs" Orientation="Horizontal">
                    <RadioButton Content="証拠金" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" IsChecked="True" Tag="equity" Checked="ResultPeriod_Checked"/>
                    <RadioButton Content="年" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" Tag="0" Checked="ResultPeriod_Checked"/>
                    <RadioButton Content="月" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" Tag="1" Checked="ResultPeriod_Checked"/>
                    <RadioButton Content="日" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" Tag="2" Checked="ResultPeriod_Checked"/>
                    <RadioButton Content="曜日" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" Tag="3" Checked="ResultPeriod_Checked"/>
                    <RadioButton Content="時間" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" Tag="4" Checked="ResultPeriod_Checked"/>
                    <RadioButton Content="分" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" Tag="5" Checked="ResultPeriod_Checked"/>
                    <RadioButton Content="取引時間" Style="{StaticResource ResultTab}" GroupName="ResultPeriod" Tag="holding" Checked="ResultPeriod_Checked"/>
                    <Button Content="相関" Style="{StaticResource HeaderButton}" Click="CorrelationView_Click" Padding="21,14"/>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="SideOptions" Orientation="Horizontal" Margin="18,12,20,0">
                  <RadioButton Content="すべて" Style="{StaticResource SideTab}" GroupName="SideFilter" IsChecked="True" Tag="0" Checked="SideFilter_Checked"/>
                  <RadioButton Content="ロング" Style="{StaticResource SideTab}" GroupName="SideFilter" Tag="1" Checked="SideFilter_Checked"/>
                  <RadioButton Content="ショート" Style="{StaticResource SideTab}" GroupName="SideFilter" Tag="2" Checked="SideFilter_Checked"/>
                  <TextBlock Text="決済損益 / ブローカー時刻" Foreground="{DynamicResource Muted}" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Margin="24,18,24,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,16,0" x:Name="AnalysisTitle" Text="レポートを取り込んで分析を始めましょう" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock x:Name="AnalysisDetail" Text="データ取込、戦略を選択、分析する の順で進めます" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="ChartMode" Width="110" SelectedIndex="0" SelectionChanged="ChartMode_Changed">
                      <ComboBoxItem Content="総損益"/>
                      <ComboBoxItem Content="残高"/>
                    </ComboBox>
                    <Button Content="全体表示" Click="ResetChart_Click" Margin="12,0,0,0"/>
                  </StackPanel>
                </Grid>
                <StackPanel x:Name="EquitySection" Margin="20,0,20,0">
                  <DockPanel Margin="62,0,12,2">
                    <TextBlock Text="● 総損益" Foreground="{DynamicResource Gain}" Margin="0,0,20,0"/>
                    <TextBlock Text="● 残高DD" Foreground="{DynamicResource Loss}"/>
                    <TextBlock x:Name="ChartTitle" Text="決済順 / ブローカー時刻" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                  </DockPanel>
                  <Grid x:Name="EquityChartLayer">
                    <local:EquityChart x:Name="MainChart" Height="350"/>
                    <Border x:Name="PeriodTrustCard" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,22,0,0" Padding="6,2" Background="Transparent" IsHitTestVisible="False">
                      <StackPanel>
                        <TextBlock x:Name="PeriodTrustValue" Text="算出不可" FontSize="24.3" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="期間的信頼スコア" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border x:Name="StatisticalTrustCard" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,82,0,0" Padding="6,2" Background="Transparent" IsHitTestVisible="False">
                      <StackPanel>
                        <TextBlock x:Name="TrustScoreValue" Text="—" FontSize="24.3" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" ToolTip="ARMADA独自の評価指標です。統計的信頼スコア = 100 − 総損益収束率。0〜100%に制限します。統計学上の信頼水準や将来の利益の確率を表すものではありません。算出不能の場合は — を表示します。"/>
                        <TextBlock Text="統計的信頼スコア" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border x:Name="ChartReturns" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,42" Padding="0" Background="Transparent" IsHitTestVisible="False">
                      <StackPanel>
                        <TextBlock TextAlignment="Center" x:Name="AnnualReturnValue" Text="算出不可" FontSize="24.3" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock TextAlignment="Center" Text="平均年利" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                        <TextBlock TextAlignment="Center" x:Name="TotalReturnValue" Text="算出不可" FontSize="24.3" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,8,0,0"/>
                        <TextBlock TextAlignment="Center" Text="総増益率" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <local:EquityChart x:Name="DrawdownChart" Height="126" Underwater="True"/>
                </StackPanel>
                <StackPanel x:Name="BreakdownSection" Visibility="Collapsed" Margin="20,0,20,12">
                  <TextBlock x:Name="BreakdownTitle" Text="年別 / 決済時刻で集計" Foreground="{DynamicResource Muted}" Margin="12,0,0,10"/>
                  <UniformGrid Columns="2">
                    <StackPanel>
                      <TextBlock Text="総損益・利益・損失" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                      <local:SummaryBarChart x:Name="ProfitBars" Height="260" Metric="Profit"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="平均損益" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                      <local:SummaryBarChart x:Name="AverageBars" Height="260" Metric="Average"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="勝数・負数" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                      <local:SummaryBarChart x:Name="CountBars" Height="245" Metric="Count"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="最大残高DD（各区分内の決済順）" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                      <local:SummaryBarChart x:Name="DrawdownBars" Height="245" Metric="Drawdown"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
                <StackPanel x:Name="HoldingSection" Visibility="Collapsed" Margin="20,0,20,20">
                  <DockPanel x:Name="HoldingControls" Margin="12,4,12,12">
                    <TextBlock Text="1 Pipの価格幅" VerticalAlignment="Center"/>
                    <TextBox x:Name="PipSizeBox" ToolTip="空欄は各通貨ペアの単位で自動換算（円ペア0.01、金0.1、対応するその他FX0.0001）。単一銘柄のみ手動指定できます。" Width="100" Margin="12,0"/>
                    <Button Content="Pips表示を更新" Click="Holding_Click"/>
                    <TextBlock Text="複数通貨ペアも自動換算。手動指定は単一銘柄のみ。" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock x:Name="HoldingSummary" Text="取引時間タブを選択して読み込みます" Foreground="{DynamicResource Muted}" Margin="12,0,12,14"/>
                  <UniformGrid Columns="2">
                    <StackPanel>
                      <TextBlock Text="保有時間と損益" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                      <local:HoldingScatterChart x:Name="HoldingProfitChart" Height="420"/>
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="保有時間とPips（売買方向調整済み価格差）" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                      <local:HoldingScatterChart x:Name="HoldingPipsChart" Height="420" IsPips="True"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
                <Separator Margin="20,4"/>
                <StackPanel x:Name="SummaryRows">
                <Grid x:Name="ScoreComparison" Margin="20,12,20,12">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel x:Name="SlippageCard" Grid.Column="0" Margin="8,3">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="AveragePipsValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Gain}"/>
                      <TextBlock Text=" / " FontSize="22.5" Foreground="{DynamicResource Muted}"/>
                      <TextBlock x:Name="SlippageValue" Text="算出不可" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                    </StackPanel></Viewbox>
                    <TextBlock FontSize="14.3" Text="平均獲得pips / スリップ耐久pips" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-10,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="PfComparisonCard" Grid.Column="1" Margin="8,3">
                    <StackPanel.ToolTip><TextBlock x:Name="PfEstimateHint" Text="分析後に自動推定します。" TextWrapping="Wrap" MaxWidth="540"/></StackPanel.ToolTip>
                    <WrapPanel HorizontalAlignment="Center">
                      <TextBlock x:Name="PfValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text=" / " FontSize="22.5" Foreground="{DynamicResource Muted}"/>
                      <TextBlock x:Name="PfEstimateValue" Text="算出不可" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                    </WrapPanel>
                    <TextBlock FontSize="14.3" Text="PF / 収束PF" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-10,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4,3">
                    <TextBlock x:Name="CountValue" Text="—" FontSize="24.3" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock FontSize="14.3" Text="総取引回数 / 総セット数" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-10,0,0"/>
                  </StackPanel>
                </Grid>
                <Grid x:Name="MoneyDdComparison" Margin="20,0,20,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                  <StackPanel x:Name="NetComparisonCard" Grid.Column="0" Margin="8,3">
                    <StackPanel.ToolTip><TextBlock x:Name="NetEstimateHint" Text="取引を分析すると推定範囲を表示します。" TextWrapping="Wrap" MaxWidth="540"/></StackPanel.ToolTip>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="NetValue" Text="—" FontSize="20.7" FontWeight="SemiBold" Foreground="{DynamicResource Gain}"/>
                      <TextBlock Text=" / " FontSize="20.7" Foreground="{DynamicResource Muted}"/>
                      <TextBlock x:Name="NetEstimateValue" Text="算出不可" FontSize="20.7" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
                      <TextBlock Text=" / " FontSize="20.7" Foreground="{DynamicResource Muted}"/>
<TextBlock x:Name="ConvergenceValue" Text="算出不可" FontSize="20.7" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"> <TextBlock.ToolTip><TextBlock x:Name="ConvergenceHint" TextWrapping="Wrap" MaxWidth="420"/></TextBlock.ToolTip></TextBlock>
                    </StackPanel></Viewbox>
                    <TextBlock FontSize="14.3" x:Name="TrustComparisonLabel" Text="総損益 / 収束総損益 / 総損益収束率" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-10,0,0"/>
                  </StackPanel>
                  <StackPanel x:Name="InitialDdComparisonCard" Grid.Column="1" Margin="8,3">
                    <StackPanel.ToolTip><TextBlock x:Name="InitialDdEstimateHint" Text="最大DD金額を初期証拠金で割った割合です。" TextWrapping="Wrap" MaxWidth="540"/></StackPanel.ToolTip>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="InitialDdPercentValue" Text="算出不可" FontSize="20.7" FontWeight="SemiBold" Foreground="{DynamicResource Loss}"/>
                      <TextBlock Text=" / " FontSize="20.7" Foreground="{DynamicResource Muted}"/>
                      <TextBlock x:Name="InitialDdEstimateValue" Text="算出不可" FontSize="20.7" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                    </StackPanel></Viewbox>
                    <TextBlock FontSize="14.3" Text="初資比DD / 収束初資比DD" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-10,0,0"/>
