                <TextBox x:Name="AutoData" Visibility="Collapsed"/>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="レポート保存先" VerticalAlignment="Center"/><TextBox x:Name="AutoOutput" Grid.Column="1"/><Button Grid.Column="2" Content="選択" Tag="output" Click="AutoBrowse_Click"/></Grid>
                <WrapPanel Margin="0,8,0,8"><TextBlock Text="制限（分）" VerticalAlignment="Center"/><ComboBox x:Name="AutoTimeout" Width="80" SelectedIndex="3"><ComboBoxItem Content="5"/><ComboBoxItem Content="15"/><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="120"/><ComboBoxItem Content="360"/><ComboBoxItem Content="1440"/></ComboBox><TextBlock Text="サーバー：選択したMTの現在の設定を使用" VerticalAlignment="Center" Margin="12,0"/><CheckBox x:Name="AutoPortable" Visibility="Collapsed" Content="ポータブル" Margin="12,0"/><CheckBox x:Name="AutoUseTds" Content="TDSを使用する" ToolTip="MT5ではTDSのDukascopyデータをUTCの専用銘柄へ取り込み、リアルティックで実行します。" Checked="AutoTds_Changed" Unchecked="AutoTds_Changed"/></WrapPanel>
                <WrapPanel><Button Content="一覧を読込" Click="AutoLoad_Click"/><Button Content="一覧を保存" Click="AutoSave_Click"/><Button Content="設定を復元" Click="AutoRecover_Click"/></WrapPanel>
                <TextBlock Text="通貨・時間足は一覧、日付はカレンダーから選択できます。MT5では気配値・履歴のある銘柄を表示し、不足履歴はサーバーから同期します。" TextWrapping="Wrap" Margin="0,6,0,8"/>
                
              </StackPanel>
              <Grid x:Name="AutoQueueArea" Grid.Row="1" SizeChanged="AutoQueue_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid x:Name="AutoJobsGrid" RowHeight="36" FontSize="12" IsReadOnly="False" CanUserSortColumns="False" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="135"/>
                  <DataGridTemplateColumn Header="EA" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="Transparent" Padding="4" Cursor="Hand" Tag="ea" MouseLeftButtonUp="AutoJobFile_CellClick" ToolTip="クリックして選択"><TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding EaName}"/><Style.Triggers><DataTrigger Binding="{Binding EaName}" Value=""><Setter Property="Text" Value="クリックして選択"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="set" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="Transparent" Padding="4" Cursor="Hand" Tag="set" MouseLeftButtonUp="AutoJobFile_CellClick" ToolTip="クリックして選択"><TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding SetName}"/><Style.Triggers><DataTrigger Binding="{Binding SetName}" Value=""><Setter Property="Text" Value="クリックして選択"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="通貨" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AutoSymbols, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Symbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="AutoSymbol_Changed" Padding="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="時間足" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AutoPeriods, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Period, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="開始日" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><DatePicker SelectedDate="{Binding From, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Padding="0" Margin="0" PreviewMouseLeftButtonDown="AutoDate_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="終了日" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><DatePicker SelectedDate="{Binding To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Padding="0" Margin="0" PreviewMouseLeftButtonDown="AutoDate_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="初期証拠金" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="−" Tag="Deposit:-100000" Click="AutoNumber_Click" Padding="2" Margin="0"/><TextBox Text="{Binding Deposit,Mode=TwoWay}" Width="76" Padding="2"/><Button Content="＋" Tag="Deposit:100000" Click="AutoNumber_Click" Padding="2" Margin="0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="口座通貨" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AutoCurrencies, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="モデル" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><TextBlock Text="{Binding TdsModelLabel, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseTdsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ComboBox ItemsSource="{Binding AutoModels, RelativeSource={RelativeSource AncestorType=Window}}" SelectedIndex="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="2"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding UseTdsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="スプレッド" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><TextBlock Text="変動" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseMarketSpread, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UseMarketSpread, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="−" Tag="Spread:-1" Click="AutoNumber_Click" Padding="2" Margin="0"/><TextBox Text="{Binding Spread,Mode=TwoWay}" Width="35" Padding="2"/><Button Content="＋" Tag="Spread:1" Click="AutoNumber_Click" Padding="2" Margin="0"/></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  
                <DataGridTemplateColumn Header="操作" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="&#xE8C8;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" ToolTip="このテストをコピー" Click="AutoDuplicate_Click" Padding="3" Margin="1"/><Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" ToolTip="このテストを削除" Click="AutoDelete_Click" Padding="3" Margin="1"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="状態" Binding="{Binding Status}" IsReadOnly="True" Width="140"/></DataGrid.Columns>
              </DataGrid>
<Button x:Name="AutoAddButton" Grid.Row="1" Content="＋" ToolTip="テストを追加" Click="AutoAdd_Click" HorizontalAlignment="Center" Margin="0,8,0,0" Width="64" Height="40" FontSize="23" Padding="0" IsEnabled="{Binding IsEnabled,ElementName=AutoJobsGrid}"/>
</Grid>
              <StackPanel Grid.Row="2" Margin="0,6,0,0"><StackPanel x:Name="AutoProgressPanel" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock x:Name="AutoProgressText" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/><ProgressBar x:Name="AutoProgress" Height="3" IsIndeterminate="False"/></StackPanel><WrapPanel><Button x:Name="AutoStart" Content="連続テスト開始" Style="{StaticResource Primary}" Click="AutoStart_Click"/><Button x:Name="AutoStop" Content="現在の1件の保存後に停止" Click="AutoStop_Click" IsEnabled="False"/><Button x:Name="AutoCancel" Content="中止" Click="AutoCancel_Click" IsEnabled="False"/><Button Content="保存先を開く" Click="AutoOpen_Click"/></WrapPanel><TextBox x:Name="AutoLog" Height="85" Margin="0,8,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel>
            </Grid>
          </TabItem>
          <TabItem Header="拡張機能">
            <Grid Margin="0,15,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Margin="0,0,0,12">
                <WrapPanel>
                  <Button Content="プラグインDLLを読み込む" Click="LoadPlugin_Click"/>
                  <Button Content="選択した拡張を実行" Click="RunPlugin_Click"/>
                  <Button Content="公開APIの説明" Click="PluginDocs_Click"/>
                </WrapPanel>
                <TextBlock Text="DLLはこのアプリと同じ権限で実行されます。自分でビルドしたものなど信頼できる拡張を選んでください。 読込形式の拡張は、読込形式の選択欄にも追加されます。" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              </StackPanel>
              <DataGrid x:Name="PluginsGrid" Grid.Row="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="拡張" Binding="{Binding Name}" Width="230"/>
                  <DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="120"/>
                  <DataGridTextColumn Header="バージョン" Binding="{Binding Version}" Width="80"/>
                  <DataGridTextColumn Header="説明" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="PluginMetricsGrid">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="指標" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="値" Binding="{Binding Value}" Width="160"/>
                    <DataGridTextColumn Header="単位" Binding="{Binding Unit}" Width="70"/>
                  </DataGrid.Columns>
                </DataGrid>
                <local:PluginChart x:Name="ExtensionChart" Grid.Column="1" Margin="14,0,0,0"/>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="計算条件">
            <ScrollViewer x:Name="ConditionsScroll" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ConditionsPanel" Background="{DynamicResource Canvas}" TextElement.Foreground="{DynamicResource Ink}">
                <DockPanel Background="{DynamicResource Surface}" Margin="0,0,0,20">
                  <StackPanel Margin="18">
                    <TextBlock Text="計算条件設定" FontSize="21"/>
                    <TextBlock Text="Home  ›  Conditions" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="全リセット" ToolTip="取り込んだデータをすべて削除し、計算条件を初期化します。元のレポートは残します。" Click="ResetConditions_Click"/>
                    <Button Content="計算開始" Style="{StaticResource Primary}" Click="ApplyConditions_Click"/>
                  </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource ConditionsCard}">
                  <StackPanel>
                    <TextBlock Text="資金管理" FontSize="20" Margin="0,0,0,18" Foreground="{DynamicResource Ink}"/>
                    <Separator Margin="-18,0,-18,18"/>
                    <TextBlock Text="正規化した元の取引損益に固定ウェイトを掛けて分析します。" Foreground="{DynamicResource Muted}" Margin="0,0,0,20"/>
                    <UniformGrid Columns="2">
                      <StackPanel Margin="12,0,30,12">
                        <TextBlock Text="資金管理方式" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="固定ウェイト（複利再計算なし）" FontSize="15" Margin="0,9"/>
                        <TextBlock Text="初期資本" Foreground="{DynamicResource Muted}" Margin="0,18,0,6"/>
                        <TextBox Text="{Binding Text,ElementName=CapitalBox,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"/>
                      </StackPanel>
                      <StackPanel Margin="12,0,30,12">
                        <TextBlock Text="金額の扱い" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="通貨を区別せず、数値のまま計算" FontSize="15" Margin="0,9"/>
                        <TextBlock Text="円・ドルなどの判定、為替換算、通貨一致による制限は行いません。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,18,0,0"/>
                      </StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource ConditionsCard}">
                  <StackPanel>
                    <TextBlock Text="データ選択" FontSize="20" Margin="0,0,0,18" Foreground="{DynamicResource Ink}"/>
                    <Separator Margin="-18,0,-18,18"/>
                    <TextBlock Text="分析対象を選択してください。ウェイト1で元の損益、0で対象外です。" Foreground="{DynamicResource Muted}" Margin="0,0,0,16"/>
                    <DataGrid x:Name="ConditionsDataGrid" AutoGenerateColumns="False" IsReadOnly="False" Height="240" CanUserAddRows="False">
                      <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="選択" Binding="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="ファイル名" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="保存形式" Binding="{Binding Format}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="取引数" Binding="{Binding Data.Count}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="通貨ペア" Binding="{Binding Data.Symbol}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="固定ウェイト" Binding="{Binding Weight,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTemplateColumn Header="削除" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <Button Click="DeleteDataset_Click" ToolTip="この取込データを削除" AutomationProperties.Name="この取込データを削除" Padding="8,4" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                      </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal"><Button Content="全データを選択" Click="SelectAll_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/><Button x:Name="DeleteSelectedDataButton" Content="選択したデータを削除" Click="DeleteSelectedDatasets_Click" Margin="12,12,0,0"/></StackPanel>
                  </StackPanel>
                </Border>
                <UniformGrid Columns="2">
                  <Border Style="{StaticResource ConditionsCard}">
                    <StackPanel>
                      <TextBlock Text="期間指定" FontSize="20" Margin="0,0,0,18" Foreground="{DynamicResource Ink}"/>
                      <Separator Margin="-18,0,-18,18"/>
                      <TextBlock Text="決済日時で対象期間を指定します。終了日はその日を含みます。" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>
                      <WrapPanel>
                        <DatePicker SelectedDate="{Binding SelectedDate,ElementName=FromDate,Mode=TwoWay}" Width="140"/>
                        <TextBlock Text="〜" Margin="8"/>
                        <DatePicker SelectedDate="{Binding SelectedDate,ElementName=ToDate,Mode=TwoWay}" Width="140"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource ConditionsCard}">
                    <StackPanel>
                      <TextBlock Text="ポートフォリオ名" FontSize="20" Margin="0,0,0,18" Foreground="{DynamicResource Ink}"/>
                      <Separator Margin="-18,0,-18,18"/>
                      <TextBlock Text="計算結果に表示する名前" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
                      <TextBox x:Name="PortfolioName" MaxLength="120"/>
                      <TextBlock Text="空欄では戦略名または選択戦略数を表示します。" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource ConditionsCard}">
                    <StackPanel>
                      <TextBlock Text="取引設定" FontSize="20" Margin="0,0,0,18" Foreground="{DynamicResource Ink}"/>
                      <Separator Margin="-18,0,-18,18"/>
                      <TextBlock Text="分析に含める売買方向" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
                      <ComboBox x:Name="ConditionSide" SelectedIndex="{Binding SelectedIndex,ElementName=SideBox,Mode=TwoWay}" Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="すべて"/>
                        <ComboBoxItem Content="ロング"/>
                        <ComboBoxItem Content="ショート"/>
                      </ComboBox>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource ConditionsCard}">
                    <StackPanel>
                      <TextBlock Text="時刻の扱い" FontSize="20" Margin="0,0,0,18" Foreground="{DynamicResource Ink}"/>
                      <Separator Margin="-18,0,-18,18"/>
                      <TextBlock Text="月・日・曜日・時・分は新規時刻で判定し、すべての選択条件を満たす取引を抽出します。" TextWrapping="Wrap" Margin="0,0,0,12"/>
                      <TextBlock Text="ブローカー時刻のまま処理します。タイムゾーン・夏時間は自動変換しません。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <Border Style="{StaticResource ConditionsCard}">
                  <Expander Style="{StaticResource CalendarExpander}" Header="月設定" IsExpanded="False" FontSize="15">
                    <StackPanel Margin="0,18,0,0">
                      <TextBlock Text="新規注文の時刻を選択してください。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="全て選択" Tag="months:all" Click="CalendarSelect_Click"/>
                        <Button Content="全て解除" Tag="months:none" Click="CalendarSelect_Click"/>
                      </StackPanel>
                      <UniformGrid x:Name="MonthsChoices" Columns="6" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Expander>
                </Border>
                <Border Style="{StaticResource ConditionsCard}">
                  <Expander Style="{StaticResource CalendarExpander}" Header="日付設定" IsExpanded="False" FontSize="15">
                    <StackPanel Margin="0,18,0,0">
                      <TextBlock Text="新規注文の時刻を選択してください。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="全て選択" Tag="days:all" Click="CalendarSelect_Click"/>
                        <Button Content="全て解除" Tag="days:none" Click="CalendarSelect_Click"/>
                      </StackPanel>
                      <UniformGrid x:Name="DaysChoices" Columns="8" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Expander>
                </Border>
                <Border Style="{StaticResource ConditionsCard}">
                  <Expander Style="{StaticResource CalendarExpander}" Header="曜日設定" IsExpanded="False" FontSize="15">
                    <StackPanel Margin="0,18,0,0">
                      <TextBlock Text="新規注文の時刻を選択してください。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="全て選択" Tag="weekdays:all" Click="CalendarSelect_Click"/>
                        <Button Content="全て解除" Tag="weekdays:none" Click="CalendarSelect_Click"/>
                      </StackPanel>
                      <UniformGrid x:Name="WeekdaysChoices" Columns="7" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Expander>
                </Border>
                <Border Style="{StaticResource ConditionsCard}">
                  <Expander Style="{StaticResource CalendarExpander}" Header="時間設定" IsExpanded="False" FontSize="15">
                    <StackPanel Margin="0,18,0,0">
                      <TextBlock Text="新規注文の時刻を選択してください。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="全て選択" Tag="hours:all" Click="CalendarSelect_Click"/>
                        <Button Content="全て解除" Tag="hours:none" Click="CalendarSelect_Click"/>
                      </StackPanel>
                      <UniformGrid x:Name="HoursChoices" Columns="8" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Expander>
                </Border>
                <Border Style="{StaticResource ConditionsCard}">
                  <Expander Style="{StaticResource CalendarExpander}" Header="分設定" IsExpanded="False" FontSize="15">
                    <StackPanel Margin="0,18,0,0">
                      <TextBlock Text="新規注文の時刻を選択してください。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="全て選択" Tag="minutes:all" Click="CalendarSelect_Click"/>
                        <Button Content="全て解除" Tag="minutes:none" Click="CalendarSelect_Click"/>
                        <Button Content="5分ごと" Tag="minutes:five" Click="CalendarSelect_Click"/>
                      </StackPanel>
                      <UniformGrid x:Name="MinutesChoices" Columns="10" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Expander>
                </Border>
                <TextBlock Text="この版は固定ウェイト方式です。経済指標による除外・不利約定補正・複利・ロット上下限・指定日注文の再現は含みません。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="18,0,18,20"/>
                <Button Content="計算開始" Click="ApplyConditions_Click" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </local:RetainedTabControl>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <Button x:Name="CancelButton" Content="キャンセル" IsEnabled="False" Click="Cancel_Click" Padding="12,4" DockPanel.Dock="Right" Margin="14,0,0,0"/>
        <Ellipse x:Name="BusySpinner" Width="18" Height="18" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeDashArray="3 2" RenderTransformOrigin="0.5,0.5" Visibility="Hidden" DockPanel.Dock="Left" Margin="0,0,10,0">
          <Ellipse.RenderTransform>
            <RotateTransform x:Name="BusyRotation"/>
          </Ellipse.RenderTransform>
        </Ellipse>
        <ProgressBar x:Name="JobProgress" Width="180" Height="7" DockPanel.Dock="Right" Margin="14,0,0,0" Minimum="0" Maximum="100"/>
        <TextBlock Text="Auto Scope" Width="202" DockPanel.Dock="Left" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Text="待機中 · データを取り込むと分析を開始できます"
                   FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>



