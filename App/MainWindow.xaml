                  <DataGridTextColumn Header="決済価格" Binding="{Binding Exit}" Width="90"/>
                  <DataGridTextColumn Header="元損益" Binding="{Binding Profit}" Width="100"/>
                  <DataGridTextColumn Header="HTML行" Binding="{Binding SourceRow}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
