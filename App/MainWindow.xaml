              <DataGrid x:Name="CorrelationGrid" Grid.Row="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="戦略 A" Binding="{Binding First}" Width="*"/>
                  <DataGridTextColumn Header="戦略 B" Binding="{Binding Second}" Width="*"/>
                  <DataGridTextColumn Header="全期間の日数" Binding="{Binding Days}" Width="120"/>
                  <DataGridTextColumn Header="日次損益相関" Binding="{Binding Value}" Width="150"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
