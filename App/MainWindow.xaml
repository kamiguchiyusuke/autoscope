                  <StackPanel Margin="4,3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="AverageProfitValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="平均利益" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
                  <StackPanel Margin="4,3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="AverageWinsValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="平均連勝数 / 理論平均" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
                  <StackPanel Margin="4,3"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="AverageLossesValue" Text="—" FontSize="22.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/></Viewbox><TextBlock FontSize="14.3" Text="平均連敗数 / 理論平均" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,-10,0,0"/></StackPanel>
